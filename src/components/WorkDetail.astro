---
/**
 * 作品の単独ページ。
 * 通常はトップページのモーダルで読まれますが、
 * モーダルを開いたときの URL 先として、また検索エンジンや JS 無効環境のために
 * このページも生成しています。内容はモーダルと同じです。
 */
import type { CollectionEntry } from 'astro:content';
import { localizePath, asset, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import YouTubeEmbed from './YouTubeEmbed.astro';
import LocalVideo from './LocalVideo.astro';
import RichText from './RichText.astro';
import ArrowIcon from './ArrowIcon.astro';
import TechList from './TechList.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'works'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const work = entry.data;
const backHref = `${localizePath('/', lang)}#works`;

---

<article class="work">
  <div class="container container--prose">
    <a class="link-arrow link-arrow--back work__back" href={backHref}>
      <ArrowIcon />
      {t('works.back')}
    </a>

    {/* 動画があれば動画、なければ写真 */}
    <div class="work__media">
        {
          work.youtube ? (
            <YouTubeEmbed videoId={work.youtube} title={work.title} loadLabel={t('works.videoLoad')} />
          ) : work.video ? (
            <LocalVideo src={work.video} poster={work.poster ?? work.cover} title={work.title} />
          ) : (
            work.cover && (
              <img
                src={asset(work.cover)}
                alt={work.coverAlt ?? ''}
                width="1200"
                height="675"
                decoding="async"
              />
            )
          )
        }
    </div>

    <h1 class="work__title">{work.title}</h1>
    <RichText class="work__description" text={work.description ?? work.summary} />

    {work.tech.length > 0 && <TechList lang={lang} tech={work.tech} grouped class="work__tech" />}

    <div class="work__footer">
      <a class="link-arrow link-arrow--back" href={backHref}>
        <ArrowIcon />
        {t('works.back')}
      </a>
    </div>
  </div>
</article>

<style>
  .work {
    padding-top: clamp(3rem, 2rem + 5vw, 5rem);
  }

  .work__back {
    margin-bottom: var(--space-4);
  }

  .work__media {
    margin-bottom: var(--space-4);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .work__media:empty {
    display: none;
  }

  .work__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .work__media :global(.video) {
    border: 0;
    border-radius: 0;
  }

  .work__title {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }

  .work__description {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .work__description > * + * {
    margin-top: var(--space-2);
  }

  /* TechList が出す要素には scope が付かないので :global() で指定する */
  .work :global(.work__tech) {
    margin-top: var(--space-6);
  }

  .work__footer {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
</style>
