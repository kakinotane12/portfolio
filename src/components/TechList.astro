---
/**
 * 使用技術の表示。2通りの出し方をここに集約している。
 *
 *  - 既定（カード）: 1行に流す。limit を渡すと超過分を「+N」で示す
 *  - grouped:       言語 / ツールで行を分ける（モーダル・詳細ページ）
 */
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { groupTech, type TechGroup } from '../data/techIcons';
import TechIcon from './TechIcon.astro';

interface Props {
  lang: Lang;
  tech: string[];
  /** 表示する最大件数。超過分は「+N」として出す */
  limit?: number;
  /** 言語 / ツールで行を分ける */
  grouped?: boolean;
  class?: string;
}

const { lang, tech, limit, grouped = false, class: className } = Astro.props;
const t = useTranslations(lang);

const label: Record<TechGroup, string> = {
  language: t('tech.language'),
  tool: t('tech.tool'),
};

const shown = limit ? tech.slice(0, limit) : tech;
const hidden = tech.length - shown.length;
---

{
  grouped ? (
    <dl class:list={['tech-groups', className]}>
      {groupTech(tech).map(({ group, items }) => (
        <div class="tech-group">
          <dt class="tech-group__label">{label[group]}</dt>
          <dd class="tech-group__items">
            <ul class="tech-list">
              {items.map((item) => (
                <li class="tech-list__item">
                  <TechIcon name={item} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  ) : (
    <ul class:list={['tech-list', className]}>
      {shown.map((item) => (
        <li class="tech-list__item">
          <TechIcon name={item} />
          <span>{item}</span>
        </li>
      ))}
      {hidden > 0 && (
        /* 省略があることをカードの時点で示す。件数まで出すほうが「etc.」より情報量がある */
        <li class="tech-list__more">+{hidden}</li>
      )}
    </ul>
  )
}
