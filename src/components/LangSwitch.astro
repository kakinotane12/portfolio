---
import { languages, langCodes, localizePath, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
---

<div class="lang" role="group" aria-label={t('lang.switch')}>
  {
    langCodes.map((code) => (
      <a
        class="lang__item"
        href={localizePath(path, code)}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? 'true' : undefined}
        data-active={code === lang}
      >
        {languages[code].short}
        <span class="visually-hidden">{languages[code].label}</span>
      </a>
    ))
  }
</div>

<style>
  .lang {
    display: flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 100px;
  }

  .lang__item {
    padding: 0.25rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    border-radius: 100px;
    line-height: 1.6;
    transition: color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .lang__item:hover {
    color: var(--text);
  }

  .lang__item[data-active='true'] {
    color: var(--text);
    background: var(--bg-subtle);
  }
</style>
