---
/**
 * 作品詳細の中身。
 * モーダル（トップページ内）と単独ページの両方から同じものを使います。
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { asset, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import YouTubeEmbed from './YouTubeEmbed.astro';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'works'>;
  /** 見出しに振る id（モーダルの aria-labelledby 用） */
  titleId?: string;
  /**
   * 見出しの階層。単独ページでは 1、モーダルでは 2。
   * トップページに h1 が複数並ばないようにするため。
   */
  level?: 1 | 2;
}

const { lang, entry, titleId, level = 1 } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const work = entry.data;

const TitleTag = level === 1 ? 'h1' : 'h2';
const BlockTag = level === 1 ? 'h2' : 'h3';

const facts = [
  { label: t('works.period'), value: work.period },
  { label: t('works.role'), value: work.role },
  ...(work.teamSize ? [{ label: t('works.team'), value: work.teamSize }] : []),
];
---

<div class="workBody">
  <header class="workBody__header">
    {work.category && <p class="eyebrow workBody__category">{work.category}</p>}
    <TitleTag class="workBody__title" id={titleId}>{work.title}</TitleTag>
    <p class="workBody__summary">{work.summary}</p>

    <dl class="workBody__facts">
      {
        facts.map((fact) => (
          <div class="workBody__fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      work.tech.length > 0 && (
        <div class="workBody__tech">
          <p class="workBody__techLabel">{t('works.tech')}</p>
          <ul class="tag-list">
            {work.tech.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </div>
      )
    }
  </header>

  {
    work.youtube && (
      <section class="workBody__block">
        <BlockTag class="workBody__blockTitle">{t('works.video')}</BlockTag>
        <YouTubeEmbed videoId={work.youtube} title={work.title} loadLabel={t('works.videoLoad')} />
      </section>
    )
  }

  <section class="workBody__block">
    <div class="prose">
      <Content />
    </div>
  </section>

  {
    work.screenshots.length > 0 && (
      <section class="workBody__block">
        <BlockTag class="workBody__blockTitle">{t('works.gallery')}</BlockTag>
        <ul class="gallery">
          {work.screenshots.map((shot) => (
            <li class="gallery__item">
              <img
                src={asset(shot.src)}
                alt={shot.alt}
                loading="lazy"
                decoding="async"
                width="1200"
                height="750"
              />
              {shot.alt && <p class="gallery__caption">{shot.alt}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    work.links.length > 0 && (
      <section class="workBody__block">
        <BlockTag class="workBody__blockTitle">{t('works.links')}</BlockTag>
        <ul class="workBody__links">
          {work.links.map((link) => (
            <li>
              <a class="workBody__linkItem" href={link.url} rel="noopener" target="_blank">
                <span>{link.label}</span>
                <ArrowIcon size="1rem" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .workBody__category {
    color: var(--accent);
  }

  .workBody__title {
    margin-top: var(--space-1);
    font-size: var(--text-2xl);
    line-height: 1.3;
  }

  .workBody__summary {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .workBody__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .workBody__fact dt {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .workBody__fact dd {
    margin: 0.3rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .workBody__tech {
    margin-top: var(--space-3);
  }

  .workBody__techLabel {
    margin-bottom: 0.6rem;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .workBody__block {
    margin-top: var(--space-8);
  }

  .workBody__blockTitle {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-1);
    font-size: var(--text-xl);
    border-bottom: 1px solid var(--border);
  }

  /* ---------- ギャラリー ---------- */
  .gallery {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__item img {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .gallery__caption {
    margin-top: 0.6rem;
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  /* ---------- リンク ---------- */
  .workBody__links {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .workBody__linkItem {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    border-bottom: 1px solid var(--border);
    transition: color 0.15s var(--ease);
  }

  .workBody__linkItem:hover {
    color: var(--accent);
  }
</style>
