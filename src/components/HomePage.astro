---
import { getCollection } from 'astro:content';
import { type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { profile, githubUrl } from '../data/profile';
import { awards } from '../data/awards';
import { skills } from '../data/skills';
import Section from './Section.astro';
import WorkCard from './WorkCard.astro';
import WorkModal from './WorkModal.astro';
import LinkedText from './LinkedText.astro';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const works = (await getCollection('works', ({ data }) => data.lang === lang && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/** 日本語ページでは英字表記を、英語ページでは日本語表記を名前の下に添える */
const nameSub = lang === 'ja' ? profile.name.en : profile.name.ja;

/**
 * カードの表紙画像。
 * cover が未設定でも youtube があれば、その動画のサムネイルを使います。
 * （hqdefault はどの動画にも必ず存在するサイズ）
 */
const coverOf = (data: (typeof works)[number]['data']) =>
  data.cover ?? (data.youtube ? `https://i.ytimg.com/vi/${data.youtube}/hqdefault.jpg` : undefined);
---

{/* ============ Hero ============ */}
<section class="hero">
  <div class="container">
    <p class="eyebrow">Portfolio</p>

    <h1 class="hero__name">{profile.name[lang]}</h1>

    <p class="hero__nameSub">
      {lang === 'ja' && <span class="hero__reading">{profile.nameReading}</span>}
      <span class="hero__romaji">{nameSub}</span>
    </p>

    <dl class="hero__meta">
      <div class="hero__metaItem">
        <dt>Affiliation</dt>
        <dd><LinkedText text={profile.affiliation[lang]} /></dd>
      </div>
    </dl>
  </div>
</section>

{/* ============ About ============ */}
<Section id="about" eyebrow={t('section.about')} title={t('section.about.lead')} prose>
  <div class="about reveal">
    {profile.about[lang].map((paragraph) => (
      <p>
        <LinkedText text={paragraph} />
      </p>
    ))}
  </div>
</Section>

{/* ============ 表彰・活動 ============ */}
<Section id="awards" eyebrow={t('section.awards')} title={t('section.awards.lead')} prose>

  <ol class="awards">
    {
      awards.map((entry) => (
        <li class="awards__item reveal">
          <p class="awards__date">{entry.date[lang]}</p>

          <div class="awards__detail">
            <p class="awards__org"><LinkedText text={entry.org[lang]} /></p>
            {entry.title && <p class="awards__title">{entry.title[lang]}</p>}

            {entry.results.filter((r) => r.award).length > 0 && (
              <ul class="awards__badges">
                {entry.results
                  .filter((r) => r.award)
                  .map((result) => (
                    <li class="awards__badge">{result.label[lang]}</li>
                  ))}
              </ul>
            )}

            {entry.results.filter((r) => !r.award).length > 0 && (
              <ul class="awards__notes">
                {entry.results
                  .filter((r) => !r.award)
                  .map((result) => (
                    <li><LinkedText text={result.label[lang]} /></li>
                  ))}
              </ul>
            )}

            {entry.links && entry.links.length > 0 && (
              <ul class="awards__links">
                {entry.links.map((link) => (
                  <li>
                    <a class="link" href={link.url} rel="noopener" target="_blank">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Section>

{/* ============ Works ============ */}
<Section id="works" eyebrow={t('section.works')} title={t('section.works.lead')}>
  <div class="works">
    {
      works.map((work) => (
        <WorkCard
          lang={lang}
          workKey={work.data.key}
          title={work.data.title}
          summary={work.data.summary}
          award={work.data.award}
          category={work.data.category}
          period={work.data.period}
          tech={work.data.tech}
          cover={coverOf(work.data)}
          coverAlt={work.data.coverAlt}
        />
      ))
    }
  </div>

  {/* 作品の中身。クリックされるまでは閉じたダイアログとして待機している */}
  {works.map((work) => <WorkModal lang={lang} entry={work} />)}
</Section>

{/* ============ Skills ============ */}
<Section id="skills" eyebrow={t('section.skills')} title={t('section.skills.lead')} prose>
  <div class="skills">
    {
      skills.map((group) => (
        <div class="skills__group reveal">
          <h3 class="skills__category">{group.category[lang]}</h3>
          <ul class="skills__list">
            {group.items.map((item) => (
              <li class="skills__item">
                <span class="skills__name">{item.name}</span>
                {item.usedIn && <span class="skills__usedIn">{item.usedIn[lang]}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

{/* ============ Links ============ */}
<Section id="links" eyebrow={t('section.links')} title={t('section.links.lead')} prose>
  <div class="links reveal">
    <ul class="links__list">
      <li>
        <a class="links__link" href={githubUrl} rel="me noopener" target="_blank">
          <span class="links__label">{t('links.github')}</span>
          <span class="links__value">@{profile.githubUser}</span>
          <ArrowIcon size="1rem" />
        </a>
      </li>
    </ul>
  </div>
</Section>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: clamp(4rem, 2rem + 10vw, 9rem);
    padding-bottom: var(--space-1);
  }

  .hero__name {
    margin-top: var(--space-2);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.025em; /* 文字が小さくなった分、詰めも弱める */
    line-height: 1.2;
  }

  .hero__nameSub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .hero__romaji {
    letter-spacing: 0.04em;
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-3);
    max-width: var(--width-content);
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  .hero__metaItem dt {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hero__metaItem dd {
    margin: 0.35rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* ---------- About ---------- */
  .about > * + * {
    margin-top: var(--space-2);
  }

  /* ---------- 表彰・活動 ---------- */
  .awards__note {
    margin-top: calc(var(--space-6) * -1 + var(--space-1));
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .awards__item {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .awards__date {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .awards__org {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* 作品名・論文名。賞名より軽くして、序列を一段下げる */
  /* 作品名・受賞・活動内容はすべて同じ体裁で、1行ずつ並べる。
     受賞は絵文字が目印になるので、太さや色では差をつけない。
     1行1項目に固定しているのは、横並びだと文字数の差で日英の行数がずれるため */
  /* 作品名・題目だけ一段だけ上げる。
     下に続く受賞・活動の見出しとして働くよう、少し下に余白も取る */
  .awards__title {
    margin: 0.4rem 0 0.5rem;
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.55;
  }

  .awards__badges,
  .awards__notes {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .awards__badge,
  .awards__notes li {
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--text);
  }

  .awards__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  @media (max-width: 34rem) {
    .awards__item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  /* ---------- Works ---------- */
  /* 枠で囲わないので、間隔で区切りをつける。
     幅に応じて 3列 → 2列 → 1列 と切り替える */
  .works {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6) var(--space-4);
  }

  @media (max-width: 62rem) {
    .works {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .works {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Skills ---------- */
  .skills {
    display: grid;
    gap: var(--space-6);
  }

  .skills__category {
    padding-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .skills__list {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .skills__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: 0.45rem;
  }

  .skills__name {
    min-width: 8rem;
    font-weight: 500;
  }

  .skills__usedIn {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  /* ---------- Links ---------- */
  .links__list {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .links__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
    transition: color 0.15s var(--ease);
  }

  .links__link:hover {
    color: var(--accent);
  }

  .links__label {
    min-width: 7rem;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .links__value {
    flex: 1;
    font-weight: 500;
    word-break: break-all;
  }
</style>
