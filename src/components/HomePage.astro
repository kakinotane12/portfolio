---
import { getCollection } from 'astro:content';
import { type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { profile, githubUrl } from '../data/profile';
import { awards } from '../data/awards';
import { skills } from '../data/skills';
import Section from './Section.astro';
import WorkCard from './WorkCard.astro';
import WorkModal from './WorkModal.astro';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const works = (await getCollection('works', ({ data }) => data.lang === lang && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/** 日本語ページでは英字表記を、英語ページでは日本語表記を名前の下に添える */
const nameSub = lang === 'ja' ? profile.name.en : profile.name.ja;
---

{/* ============ Hero ============ */}
<section class="hero">
  <div class="container">
    <p class="eyebrow hero__eyebrow">Portfolio</p>

    <h1 class="hero__name">{profile.name[lang]}</h1>

    <p class="hero__nameSub">
      {lang === 'ja' && <span class="hero__reading">{profile.nameReading}</span>}
      <span class="hero__romaji">{nameSub}</span>
    </p>

    <p class="hero__intro">{profile.intro[lang]}</p>

    <dl class="hero__meta">
      <div class="hero__metaItem">
        <dt>Affiliation</dt>
        <dd>{profile.affiliation[lang]}</dd>
      </div>
      <div class="hero__metaItem">
        <dt>Graduation</dt>
        <dd>{profile.graduation[lang]}</dd>
      </div>
    </dl>
  </div>
</section>

{/* ============ About ============ */}
<Section id="about" eyebrow={t('section.about')} title={t('section.about.lead')} prose>
  <div class="about reveal">
    {profile.about[lang].map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>

{/* ============ 表彰・活動 ============ */}
<Section id="awards" eyebrow={t('section.awards')} title={t('section.awards.lead')} prose>
  <p class="muted awards__note reveal">{t('awards.note')}</p>

  <ol class="awards">
    {
      awards.map((entry) => (
        <li class="awards__item reveal">
          <p class="awards__date">{entry.date[lang]}</p>

          <div class="awards__detail">
            <p class="awards__org">{entry.org[lang]}</p>
            <p class="awards__title">{entry.title[lang]}</p>

            {entry.results.filter((r) => r.award).length > 0 && (
              <ul class="awards__badges">
                {entry.results
                  .filter((r) => r.award)
                  .map((result) => (
                    <li class="awards__badge">{result.label[lang]}</li>
                  ))}
              </ul>
            )}

            {entry.results.filter((r) => !r.award).length > 0 && (
              <ul class="awards__notes">
                {entry.results
                  .filter((r) => !r.award)
                  .map((result) => (
                    <li>{result.label[lang]}</li>
                  ))}
              </ul>
            )}

            {entry.links && entry.links.length > 0 && (
              <ul class="awards__links">
                {entry.links.map((link) => (
                  <li>
                    <a class="link" href={link.url} rel="noopener" target="_blank">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Section>

{/* ============ Works ============ */}
<Section id="works" eyebrow={t('section.works')} title={t('section.works.lead')}>
  <div class="works">
    {
      works.map((work) => (
        <WorkCard
          lang={lang}
          workKey={work.data.key}
          title={work.data.title}
          summary={work.data.summary}
          category={work.data.category}
          period={work.data.period}
          role={work.data.role}
          tech={work.data.tech}
          cover={work.data.cover}
          coverAlt={work.data.coverAlt}
        />
      ))
    }
  </div>

  {/* 作品の中身。クリックされるまでは閉じたダイアログとして待機している */}
  {works.map((work) => <WorkModal lang={lang} entry={work} />)}
</Section>

{/* ============ Skills ============ */}
<Section id="skills" eyebrow={t('section.skills')} title={t('section.skills.lead')} prose>
  <div class="skills">
    {
      skills.map((group) => (
        <div class="skills__group reveal">
          <h3 class="skills__category">{group.category[lang]}</h3>
          <ul class="skills__list">
            {group.items.map((item) => (
              <li class="skills__item">
                <span class="skills__name">{item.name}</span>
                {item.usedIn && <span class="skills__usedIn">{item.usedIn[lang]}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

{/* ============ Contact ============ */}
<Section id="contact" eyebrow={t('section.contact')} title={t('section.contact.lead')} prose>
  <div class="contact reveal">
    <p class="contact__lead">{t('contact.lead')}</p>

    <ul class="contact__list">
      <li>
        <a class="contact__link" href={`mailto:${profile.email}`}>
          <span class="contact__label">{t('contact.email')}</span>
          <span class="contact__value">{profile.email}</span>
          <ArrowIcon size="1rem" />
        </a>
      </li>
      <li>
        <a class="contact__link" href={githubUrl} rel="me noopener" target="_blank">
          <span class="contact__label">{t('contact.github')}</span>
          <span class="contact__value">@{profile.githubUser}</span>
          <ArrowIcon size="1rem" />
        </a>
      </li>
    </ul>
  </div>
</Section>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: clamp(4rem, 2rem + 10vw, 9rem);
    padding-bottom: var(--space-8);
  }

  .hero__name {
    margin-top: var(--space-2);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.025em; /* 文字が小さくなった分、詰めも弱める */
    line-height: 1.2;
  }

  .hero__nameSub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .hero__romaji {
    letter-spacing: 0.04em;
  }

  .hero__intro {
    max-width: var(--width-prose);
    margin-top: var(--space-4);
    color: var(--text-muted);
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-3);
    max-width: var(--width-content);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .hero__metaItem dt {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hero__metaItem dd {
    margin: 0.35rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* ---------- About ---------- */
  .about > * + * {
    margin-top: var(--space-2);
  }

  /* ---------- 表彰・活動 ---------- */
  .awards__note {
    margin-top: calc(var(--space-6) * -1 + var(--space-1));
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .awards__item {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .awards__date {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .awards__org {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .awards__title {
    margin-top: 0.35rem;
    font-weight: 500;
    line-height: 1.6;
  }

  /* 受賞はアクセント色のバッジで目立たせる */
  .awards__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .awards__badge {
    padding: 0.25em 0.8em;
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.7;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 100px;
  }

  /* 受賞以外（発表形態・展示など）は補足として控えめに */
  .awards__notes {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .awards__notes li {
    position: relative;
    padding-left: 1rem;
    line-height: 1.8;
  }

  .awards__notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.4rem;
    height: 1px;
    background: var(--border-strong);
  }

  .awards__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  @media (max-width: 34rem) {
    .awards__item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  /* ---------- Works ---------- */
  .works {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-3);
  }

  /* ---------- Skills ---------- */
  .skills {
    display: grid;
    gap: var(--space-6);
  }

  .skills__category {
    padding-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .skills__list {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .skills__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: 0.45rem;
  }

  .skills__name {
    min-width: 8rem;
    font-weight: 500;
  }

  .skills__usedIn {
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  /* ---------- Contact ---------- */
  .contact__lead {
    color: var(--text-muted);
  }

  .contact__list {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .contact__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
    transition: color 0.15s var(--ease);
  }

  .contact__link:hover {
    color: var(--accent);
  }

  .contact__label {
    min-width: 7rem;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .contact__value {
    flex: 1;
    font-weight: 500;
    word-break: break-all;
  }
</style>
