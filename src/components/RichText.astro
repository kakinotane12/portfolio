---
/**
 * 説明文の表示。
 * - 改行で段落に分けます
 * - 各段落の中のリンクは LinkedText が処理します
 */
import LinkedText from './LinkedText.astro';

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;

const paragraphs = text.split('\n').filter((line) => line.trim());
---

<div class={className}>
  {
    paragraphs.map((paragraph) => (
      <p>
        <LinkedText text={paragraph} />
      </p>
    ))
  }
</div>
