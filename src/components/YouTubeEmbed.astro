---
/**
 * YouTube の軽量埋め込み。
 * 最初はサムネイルだけを置き、クリックされてから iframe を差し込みます。
 * 通常の埋め込みはプレイヤーだけで 1MB 近く読み込むため、
 * 採用担当が最初に開く数秒を守る意味でこの形にしています。
 */
interface Props {
  videoId: string;
  title: string;
  /** ボタンのラベル（多言語） */
  loadLabel: string;
}

const { videoId, title, loadLabel } = Astro.props;
// maxresdefault は高画質だが動画によっては存在しないので、無ければ hqdefault に落とす
const thumbnail = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
const thumbnailFallback = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div class="video" data-video-id={videoId} data-title={title}>
  <button class="video__button" type="button" aria-label={loadLabel}>
    <img
      class="video__thumb"
      src={thumbnail}
      data-fallback={thumbnailFallback}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="video__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
    </span>
    <span class="video__label">{loadLabel}</span>
  </button>
</div>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* 再生中はサムネイルの上に重ねる。差し替えではなく重ねることで、
     停止したときに元のサムネイルへ戻せる */
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video.is-playing .video__button {
    visibility: hidden;
  }

  .video__button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
  }

  .video__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video__play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 100px;
    backdrop-filter: blur(2px);
    transition: background-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .video__play svg {
    width: 2rem;
    height: 2rem;
    margin-left: 2px;
  }

  .video__button:hover .video__play {
    background: var(--accent);
    transform: scale(1.05);
  }

  .video__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.75rem 1rem;
    font-size: var(--text-xs);
    color: #fff;
    text-align: left;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  }
</style>

<script>
  // 高画質サムネイルが無い動画では 404 画像になるため、標準サイズに差し替える
  document.querySelectorAll<HTMLImageElement>('.video__thumb[data-fallback]').forEach((img) => {
    img.addEventListener(
      'error',
      () => {
        const fallback = img.dataset.fallback;
        if (fallback && img.src !== fallback) img.src = fallback;
      },
      { once: true },
    );
  });

  document.querySelectorAll<HTMLElement>('.video').forEach((wrapper) => {
    const button = wrapper.querySelector('.video__button');
    button?.addEventListener('click', () => {
      const id = wrapper.dataset.videoId;
      const title = wrapper.dataset.title ?? '';
      if (!id) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      wrapper.appendChild(iframe);
      wrapper.classList.add('is-playing');
    });
  });

  /**
   * 再生を止める。
   * iframe を消さないと、モーダルを閉じても音声が鳴り続ける。
   * YouTube の API を読み込まずに確実に止めるため、要素ごと破棄している。
   */
  document.addEventListener('video:stop', () => {
    document.querySelectorAll<HTMLElement>('.video.is-playing').forEach((wrapper) => {
      wrapper.querySelector('iframe')?.remove();
      wrapper.classList.remove('is-playing');
    });
  });
</script>
