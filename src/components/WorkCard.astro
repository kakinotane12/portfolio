---
import { localizePath, asset, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import ArrowIcon from './ArrowIcon.astro';
import TechList from './TechList.astro';

interface Props {
  lang: Lang;
  workKey: string;
  title: string;
  summary: string;
  award?: string;
  category?: string;
  period: string;
  tech: string[];
  cover?: string;
  coverAlt?: string;
}

const { lang, workKey, title, summary, award, category, period, tech, cover, coverAlt } =
  Astro.props;

const t = useTranslations(lang);
const href = localizePath(`/works/${workKey}`, lang);

/** award は改行で区切って複数書ける。1行につき1項目として並べる */
const awardLines = (award ?? '')
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean);
---

<article class="card reveal">
  <!-- href は残しておく。JS がモーダルを開き、Ctrl+クリックや検索エンジンには通常ページとして機能する -->
  <a class="card__link" href={href} data-work-open={workKey}>
    <div class="card__media">
      {
        cover ? (
          <img
            src={asset(cover)}
            alt={coverAlt ?? ''}
            loading="lazy"
            decoding="async"
            width="800"
            height="500"
          />
        ) : (
          <div class="card__placeholder" aria-hidden="true" />
        )
      }
    </div>

    <div class="card__body">
      <div class="card__meta">
        {category && <span class="card__category">{category}</span>}
        <span class="card__period">{period}</span>
      </div>

      <h3 class="card__title">{title}</h3>
      <p class="card__summary">{summary}</p>
      {/* 受賞・技術は中身が無くても要素は出す。カード間で行数を一定に保つため（下の subgrid 参照） */}
      <ul class="card__awards">
        {awardLines.map((line) => (
          <li>{line}</li>
        ))}
      </ul>

      {/* カードでは主要なものだけ。全件はモーダル／詳細ページに出す */}
      <TechList lang={lang} tech={tech} limit={5} class="card__tech" />

      <span class="link-arrow card__cta">
        {t('works.detail')}
        <ArrowIcon />
      </span>
    </div>
  </a>
</article>

<style>
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-subtle);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .card:hover .card__media img {
    transform: scale(1.03);
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 60%),
      var(--bg-subtle);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__meta {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-faint);
  }

  .card__category {
    color: var(--accent);
    font-weight: 500;
  }

  /* 期間は本文（card__summary）と同じ濃さに揃える */
  .card__period {
    color: var(--text-muted);
  }

  .card__title {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    /* 見出しの既定（global.css の text-wrap: balance）は行の長さを揃えようとして
       幅を使い切る前に折り返す。カード内では右端まで詰めたいので打ち消す */
    text-wrap: wrap;
  }

  /* タイトル（20px）より一段だけ小さくする。差は色でつける */
  .card__summary {
    margin-top: 0.6rem;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-muted);
    /* 最終行が短くなるのを避ける既定の調整（text-wrap: pretty）を打ち消し、
       右端まで文字を詰める */
    text-wrap: wrap;
  }

  /* summary と同じ体裁。強調は「表彰・活動」セクションが担う。
     award に改行を入れると、1行につき1項目として並ぶ */
  .card__awards {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card__awards li {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: wrap;
  }

  .card__awards li + li {
    margin-top: 0.2rem;
  }

  .card__tech {
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  .card__awards:not(:has(li)),
  .card__tech:not(:has(li)) {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .card__cta {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  /* カード同士で「タイトル」「概要」「受賞」「技術」の開始位置を横方向にそろえる。
     カード内部の行を .works グリッドの行に subgrid でつなぐことで、
     行の高さが横並びのカード全体で共有される。
     非対応ブラウザでは上の flex レイアウトのまま（そろわないだけで崩れはしない）。 */
  @supports (grid-template-rows: subgrid) {
    .card,
    .card__link,
    .card__body {
      display: grid;
      grid-template-rows: subgrid;
      /* 親 .works の row-gap（3rem）がカード内部の行間にも効くので打ち消す */
      row-gap: 0;
    }

    /* 画像 1 行 + 本文 6 行（メタ・見出し・概要・受賞・技術・詳細リンク） */
    .card,
    .card__link {
      grid-row: span 7;
    }

    .card__body {
      grid-row: span 6;
    }
  }
</style>
