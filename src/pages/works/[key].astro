---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkDetail from '../../components/WorkDetail.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => data.lang === 'ja' && !data.draft);
  return works.map((entry) => ({
    params: { key: entry.data.key },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'works'> };

const { entry } = Astro.props;
const lang = 'ja' as const;
---

<Base
  lang={lang}
  path={`/works/${entry.data.key}`}
  title={entry.data.title}
  description={entry.data.summary}
>
  <WorkDetail lang={lang} entry={entry} />
</Base>
